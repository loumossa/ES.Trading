<UserControl x:Class="ES.Trading.DesktopApp.Views.MarketOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPrimaryBrush}">
    <UserControl.Resources>

        <!-- Impact tier badge: HOT / MID / LOW with color -->
        <Style x:Key="ImpactBadge" TargetType="Border">
            <Setter Property="CornerRadius"     Value="2"/>
            <Setter Property="Padding"          Value="6,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background"       Value="{StaticResource BgElevatedBrush}"/>
        </Style>

        <!-- Rank pill for top-events -->
        <Style x:Key="RankPill" TargetType="Border">
            <Setter Property="CornerRadius"        Value="10"/>
            <Setter Property="Width"               Value="22"/>
            <Setter Property="Height"              Value="22"/>
            <Setter Property="Background"          Value="{StaticResource BgElevatedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <!-- Quote card -->
        <Style x:Key="QuoteCard" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource BgElevatedBrush}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="3"/>
            <Setter Property="Padding"          Value="10,8"/>
            <Setter Property="Margin"           Value="0,0,8,8"/>
            <Setter Property="MinWidth"         Value="130"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header bar ──────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="MORNING MARKET OVERVIEW"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding WindowLabel}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusLabel}"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Bottom" HorizontalAlignment="Right"
                           Margin="0,0,12,0"/>

                <Button Grid.Column="2" Content="Refresh" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        Padding="14,6"/>
            </Grid>
        </Border>

        <!-- ── Scrolling content ──────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24">

                <!-- ── Overnight strip ────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="OVERNIGHT" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl ItemsSource="{Binding OvernightQuotes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource QuoteCard}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,1,0,4"/>
                                            <TextBlock Text="{Binding LastLabel}"
                                                       FontSize="18" FontWeight="Light"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock x:Name="ChangeText"
                                                           Text="{Binding ChangeLabel}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text=" "/>
                                                <TextBlock x:Name="PctText"
                                                           Text="{Binding PctLabel}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUp}" Value="True">
                                            <Setter TargetName="ChangeText" Property="Foreground"
                                                    Value="{StaticResource AccentGreenBrush}"/>
                                            <Setter TargetName="PctText" Property="Foreground"
                                                    Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUp}" Value="False">
                                            <Setter TargetName="ChangeText" Property="Foreground"
                                                    Value="{StaticResource AccentRedBrush}"/>
                                            <Setter TargetName="PctText" Property="Foreground"
                                                    Value="{StaticResource AccentRedBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Today's economic calendar ──────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TODAY'S ECONOMIC CALENDAR" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="No scheduled releases today."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EconomicEvents.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <DataGrid ItemsSource="{Binding EconomicEvents}"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  MaxHeight="260" Margin="0,4,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time"     Binding="{Binding TimeLabel}" Width="80"/>
                                <DataGridTextColumn Header="Ccy"      Binding="{Binding Country}"   Width="50"/>
                                <DataGridTextColumn Header="Event"    Binding="{Binding Title}"     Width="*"/>
                                <DataGridTemplateColumn Header="Impact" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Badge" Style="{StaticResource ImpactBadge}">
                                                <TextBlock Text="{Binding ImpactLabel}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Impact}" Value="High">
                                                    <Setter TargetName="Badge" Property="Background"
                                                            Value="{StaticResource AccentRedBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Impact}" Value="Medium">
                                                    <Setter TargetName="Badge" Property="Background"
                                                            Value="{StaticResource AccentAmberBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Impact}" Value="Low">
                                                    <Setter TargetName="Badge" Property="Background"
                                                            Value="{StaticResource BgElevatedBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Forecast" Binding="{Binding Forecast}" Width="80"/>
                                <DataGridTextColumn Header="Previous" Binding="{Binding Previous}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ── Top ranked events ──────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TOP-RANKED EVENTS (OVERNIGHT)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="No events ranked — sources may have returned empty."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TopEvents.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding TopEvents}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="0,8,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource RankPill}"
                                                    VerticalAlignment="Top" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Rank}" FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                                <TextBlock TextWrapping="Wrap">
                                                    <Hyperlink NavigateUri="{Binding Url, Mode=OneWay}"
                                                               RequestNavigate="OnHyperlinkNavigate"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextDecorations="{x:Null}">
                                                        <Run Text="{Binding Headline, Mode=OneWay}"
                                                             FontWeight="SemiBold"/>
                                                    </Hyperlink>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Source}" FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text=" • " FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding TimeLabel}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text=" • " FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding SectorLabel}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text=" • " FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding BreadthLabel}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ScoreReason}"
                                                           FontSize="10" FontStyle="Italic"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding ScoreLabel}"
                                                           FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBlueBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="score" FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Sector heat ────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SECTOR HEAT" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="No sector-flagged events."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SectorHeat.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding SectorHeat}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="0,8,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding SectorLabel}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="{Binding EventCount, Mode=OneWay}"/>
                                                    <Run Text=" events"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TopHeadlines}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,12,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ScoreLabel}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Source errors (shown only if any) ──────────── -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="SOURCE ERRORS" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl ItemsSource="{Binding SourceErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10"
                                               Foreground="{StaticResource AccentAmberBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl x:Class="ES.Trading.DesktopApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{StaticResource BgPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Top stat cards ──────────────────────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Today discipline -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TODAY'S DISCIPLINE" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TodayScoreLabel}" Style="{StaticResource StatNumber}" FontSize="32"/>
                        <TextBlock Text="Rules followed today" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>

                <!-- Rolling discipline -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ROLLING DISCIPLINE" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding RollingScoreLabel}" Style="{StaticResource StatNumber}" FontSize="32"/>
                        <TextBlock Text="Last 20 sessions" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>

                <!-- Today P&L -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TODAY'S P&amp;L" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TodayPLText" Style="{StaticResource StatNumber}" FontSize="32"
                                   Text="{Binding TodayPL, StringFormat='${0:F2}'}"/>
                        <TextBlock Text="Realized today" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>

                <!-- Attempts -->
                <Border Grid.Column="6" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TODAY'S ATTEMPTS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TodayAttempts}" Style="{StaticResource StatNumber}" FontSize="32"/>
                        <TextBlock Text="{Binding TodayBias}" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Charts row ──────────────────────────────────────────────── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Rule breakdown -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RULE PASS RATE (ROLLING)" Style="{StaticResource SectionHeader}"/>
                        <DataGrid ItemsSource="{Binding RuleBreakdown}"
                                  IsReadOnly="True" Height="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rule"      Binding="{Binding Label}"    Width="*"/>
                                <DataGridTextColumn Header="Rate"      Binding="{Binding PassRate}" Width="55"/>
                                <DataGridTextColumn Header="Pass/Total" Binding="{Binding PassedAndTotal}" Width="70"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWorst}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                        <TextBlock Margin="0,8,0,0" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Amber = below 70% pass rate"/>
                    </StackPanel>
                </Border>

                <!-- Discipline trend chart -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DISCIPLINE TREND" Style="{StaticResource SectionHeader}"/>
                        <lvc:CartesianChart
                            Series="{Binding DisciplineSeries}"
                            XAxes="{Binding DisciplineXAxes}"
                            YAxes="{Binding DisciplineYAxes}"
                            Height="200"
                            Background="Transparent"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Time of day P&L chart ───────────────────────────────────── -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="P&amp;L BY TIME OF DAY (RTH)" Style="{StaticResource SectionHeader}"/>
                        <Button Content="Refresh" HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}"
                                Padding="10,4" FontSize="11" Margin="0,8,0,4"/>
                    </Grid>
                    <lvc:CartesianChart
                        Series="{Binding TimeOfDaySeries}"
                        XAxes="{Binding TimeOfDayXAxes}"
                        Height="200"
                        Background="Transparent"/>
                    <TextBlock Margin="0,6,0,0" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Aggregate P&amp;L across all sessions by 30-minute RTH bucket"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
